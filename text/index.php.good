<?php
header('Content-Type: text/html');

$str = $_GET['pic'] ?? '';
if (empty($str) || strlen($str) !== 256) {
	die("invalid image");
}

$html = <<<'EOD'
<!DOCTYPE html>
<html>
<head>
	<title>Text art</title>
	<style><!--
	code {
		font-family: "Victor Mono Medium", monospace;
	}
	.pic {
		display: block;
		width: 18em;
		width: fit-content;
		border: 1px solid hotpink;
		background: white;
	}
	.pic br,
	.border {
		display: none;
	}
	.black {
		color: black;
		background: black;
	}
	.white {
		color: white;
		background: white;
	}
	.row {
		display: block;
		width: 100%;
		height: 1.1em;
		overflow: hidden;
	}
	@media (prefers-color-scheme: dark) {
		body {
			background: black;
		}
	}
	--></style>
<body>
	<div class="pic">
		<code class="border">+--------------------------------+</code>
		<br>

EOD;

for ($i = 0, $y = 0; $i < 256; $i++) {
	if ($i % 16 == 0) {
		$html .= <<<'EOD'
				<code class="row"><span class="border">|</span>
		EOD;
		if ($i > 0) {
			$y++;
		}
	}
	if ($str[$i]) {
		$html .= '<span class="black">&#9608;&#9608;</span>';
	}
	else {
		$html .= '<span class="white">&nbsp;&nbsp;</span>';
	}
	if (($i + 1) % 16 == 0) {
		$html .= '<span class="border">|</span></code><br>';
		$html .= "\n";
	}
}
$html .= <<<'EOD'
		<code class="border">+--------------------------------+</code>
		<br>
	</div>
</body>
</html>
EOD;
print $html;
exit();
?>
